{
  "name": "eu-stats",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "backend": "mvn -f backend/pom.xml spring-boot:run",
    "dev:backend": "npm run backend",
    "frontend": "npm --workspace frontend run dev",
    "dev:frontend": "npm run frontend",
    "build:tracker": "npm --workspace frontend run build:tracker",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "mvn -f backend/pom.xml -B clean package -Dmaven.test.skip=true",
    "all": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\""
  }
}
